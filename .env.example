# BookMyFlight - Frontend Environment Variables
# Copy this file to .env or .env.local for local overrides.
# NOTE: Never commit sensitive keys or secrets into the frontend.

# URL of the Python + FastAPI backend service (deployed on Render or local dev)
VITE_API_URL=http://localhost:8000

# Future production backend URL reference (set in Vercel project environment settings):
# VITE_API_URL=https://hp-backend.onrender.com

# Supabase Authentication (Email / Password Auth)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
